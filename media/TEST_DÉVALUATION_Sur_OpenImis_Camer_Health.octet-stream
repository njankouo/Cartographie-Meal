.SCWude { animation: 0.2s ease 0s 1 normal forwards running quantumWizPaperAnimateSelectOut; position: relative; width: 20px; height: 20px; cursor: pointer; }

[aria-checked="true"] > .SCWude { animation: 0.2s ease 0.1s 1 normal forwards running quantumWizPaperAnimateSelectIn; }

