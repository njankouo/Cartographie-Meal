[aria-disabled="true"] .t5nRo { border-color: rgba(0, 0, 0, 0.26); }

.k5cvGe { transform: scale(3); transition: opacity 0.15s ease 0s; background-color: rgba(0, 0, 0, 0.2); border-radius: 100%; height: 20px; left: 0px; opacity: 0; outline: transparent solid 0.1px; pointer-events: none; position: absolute; width: 20px; z-index: -1; }

