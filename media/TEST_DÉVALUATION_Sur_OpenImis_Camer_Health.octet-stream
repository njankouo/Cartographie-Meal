.wEIpqb { position: absolute; top: 50%; left: 50%; border-radius: 50%; border: 5px solid rgb(0, 150, 136); transition: transform 0.28s ease 0s, -webkit-transform 0.28s ease 0s; transform: translateX(-50%) translateY(-50%) scale(0); }

[aria-checked="true"] .wEIpqb { transform: translateX(-50%) translateY(-50%) scale(1); }

.zJKIV[aria-disabled="true"] { cursor: default; pointer-events: none; }

