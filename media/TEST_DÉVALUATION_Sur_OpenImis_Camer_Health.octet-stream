  0% { transform: scaleX(1); opacity: 1; }
  100% { transform: scaleX(1); opacity: 0; }
}

@-webkit-keyframes quantumWizPaperInputAddUnderline { 
  0% { transform: scaleX(0); }
  100% { transform: scaleX(1); }
}

@keyframes quantumWizPaperInputAddUnderline { 
